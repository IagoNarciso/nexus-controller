{
  "version": 2,
  "functions": {
    "src/server.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/src/server.js" },
    { "source": "/((?!js/|css/|images/|login\\.html|dashboard\\.html|produtos\\.html|fornecedores\\.html|movimentacoes\\.html|solicitacoes\\.html|configuracoes\\.html).*)", "destination": "/src/server.js" }
  ]
}